generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  entitlement   Entitlement?
  pages         Page[]
  onboarding    Onboarding?
  assets        Asset[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Plan {
  key          String               @id
  name         String
  pageLimit    Int
  active       Boolean              @default(true)
  entitlements Entitlement[]
  templates    PlanTemplateAccess[]
  blocks       PlanBlockAccess[]
}

model Entitlement {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey   String
  plan      Plan     @relation(fields: [planKey], references: [key], onDelete: Restrict)
  updatedAt DateTime @updatedAt
}

model Template {
  key         String               @id
  name        String
  description String
  thumbnail   String?
  active      Boolean              @default(true)
  version     Int                  @default(1)
  config      Json
  plans       PlanTemplateAccess[]
  pages       Page[]
  updatedAt   DateTime             @updatedAt
}

model BlockDefinition {
  key           String            @id
  name          String
  description   String
  active        Boolean           @default(true)
  schemaVersion Int               @default(1)
  plans         PlanBlockAccess[]
  updatedAt     DateTime          @updatedAt
}

model PlanTemplateAccess {
  planKey     String
  templateKey String
  plan        Plan     @relation(fields: [planKey], references: [key], onDelete: Cascade)
  template    Template @relation(fields: [templateKey], references: [key], onDelete: Cascade)

  @@id([planKey, templateKey])
}

model PlanBlockAccess {
  planKey  String
  blockKey String
  plan     Plan            @relation(fields: [planKey], references: [key], onDelete: Cascade)
  block    BlockDefinition @relation(fields: [blockKey], references: [key], onDelete: Cascade)

  @@id([planKey, blockKey])
}

model Page {
  id                 String             @id @default(uuid())
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug               String             @unique
  templateKey        String
  template           Template           @relation(fields: [templateKey], references: [key], onDelete: Restrict)
  templateVersion    Int
  templateConfig     Json
  draft              Json
  revision           Int                @default(1)
  publishedVersionId String?            @unique
  publishedVersion   PublishedVersion?  @relation("PublishedPointer", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           PublishedVersion[] @relation("PageHistory")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  onboarding Onboarding?

  @@index([ownerId])
}

model PublishedVersion {
  id             String   @id @default(uuid())
  pageId         String
  page           Page     @relation("PageHistory", fields: [pageId], references: [id], onDelete: Cascade)
  sourceRevision Int
  schemaVersion  Int
  document       Json
  createdAt      DateTime @default(now())
  currentFor     Page?    @relation("PublishedPointer")

  @@unique([pageId, id])
  @@index([pageId])
}

model Onboarding {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision        Int      @default(0)
  state           Json
  completedPageId String?  @unique
  completedPage   Page?    @relation(fields: [completedPageId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
}

model Asset {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  mimeType   String
  bytes      Int
  createdAt  DateTime @default(now())

  @@index([ownerId])
}
