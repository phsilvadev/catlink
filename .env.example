# Server-only settings. Required to enable registration, login and the protected editor.
# PostgreSQL: use a local disposable database for development.
DATABASE_URL=postgresql://catlink:catlink@localhost:5432/catlink
# Optional separate direct connection for migrations, depending on database setup.
DIRECT_URL=postgresql://catlink:catlink@localhost:5432/catlink
# Generate a unique secret of at least 32 characters. Never commit real secrets.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Railway bucket credentials: required for optional profile photo uploads.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Email integration deferred; no provider or API key required in this stage.
